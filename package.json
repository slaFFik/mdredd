{
  "name": "mdredd",
  "version": "0.1.0",
  "description": "A/B test your Claude Code instruction files.",
  "type": "module",
  "bin": {
    "mdredd": "./bin/mdredd.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "start": "node dist/server/index.js",
    "test": "npm run test:judge && npm run test:preflight && npm run test:runner && npm run test:sandbox",
    "test:runner": "tsx test/runner.smoke.ts",
    "test:judge": "tsx test/judge.spec.ts",
    "test:preflight": "tsx test/preflight.spec.ts",
    "test:sandbox": "tsx test/sandbox.spec.ts"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.8",
    "get-port": "^7.2.0",
    "ignore": "^7.0.5",
    "json5": "^2.2.3",
    "open": "^11.0.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "license": "MIT"
}
